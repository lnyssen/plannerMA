# Copiez ce fichier en .env et complétez les valeurs.
# En développement local (voir README), les valeurs par défaut ci-dessous
# fonctionnent telles quelles avec la base créée par le script d'installation.

# --- Base de données --------------------------------------------------------
DATABASE_URL="postgresql://planning_studios:planning_studios_dev@localhost:5432/planning_studios_dev"

# --- Authentification (Auth.js) --------------------------------------------
# Générez une valeur avec : npx auth secret
AUTH_SECRET="changez-moi"
AUTH_URL="http://localhost:3000"

# --- Stockage de fichiers (compatible S3 — Infomaniak Public Cloud Object Storage) ---
# Laissez vide en développement : les pièces jointes de type FILE sont alors désactivées
# et seuls les liens externes (SharePoint, Drive...) restent disponibles.
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Envoi de courriels (récap quotidien, alertes d'attribution) -----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Planning Média Animation <planning@media-animation.be>"

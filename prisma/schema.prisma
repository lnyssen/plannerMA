// Schéma de la base de données — Studio planner (Média Animation asbl)
//
// Conventions : modèles et champs en anglais (écosystème Prisma/TypeScript),
// tables et colonnes SQL en snake_case (@@map/@map) pour rester lisible en
// psql. Les commentaires métier sont en français : c'est la langue de
// l'équipe qui maintiendra cette base après la livraison.
//
// Ce schéma reprend le modèle de données du prototype
// `planning-studios-v6.jsx` (projets, tâches, sous-tâches, personnes,
// absences, demandes, commentaires, pièces jointes, journal), en le
// transformant en un schéma relationnel réel : identifiants générés côté
// serveur, clés étrangères, migrations versionnées.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne vit plus ici mais dans prisma.config.ts
// (pour la CLI) et dans src/lib/db.ts (pour l'application, via l'adaptateur
// @prisma/adapter-pg). Voir https://pris.ly/d/prisma7-client-config.
datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------------------------
// Comptes et rôles
// --------------------------------------------------------------------------

/// Les trois rôles définis par le brief. STUDIO_LEAD n'a aujourd'hui pas plus
/// de droits qu'un COLLABORATOR au niveau des données (à affiner à l'usage) ;
/// seul ADMIN débloque la vue Réglages, la corbeille et la suppression
/// définitive.
enum Role {
  ADMIN
  STUDIO_LEAD
  COLLABORATOR
}

/// Compte de connexion nominatif. Remplace le mot de passe commun du
/// prototype (lignes 996-1043 du fichier source) : une vraie identité, liée
/// à une fiche Person pour retrouver "mes tâches" sans sélecteur déclaratif.
///
/// Authentification par identifiants (courriel + mot de passe haché) pour le
/// lancement. `passwordHash` reste nullable pour permettre plus tard un
/// compte relié uniquement à un fournisseur externe (Entra ID / Microsoft
/// 365), sans migration de schéma — il suffira d'ajouter les tables
/// `Account`/`Session` du provider OAuth choisi le jour venu.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  role         Role      @default(COLLABORATOR)
  person       Person?   @relation(fields: [personId], references: [id])
  personId     String?   @unique @map("person_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  /// Alerte par courriel à l'attribution d'une tâche (soi-même comme destinataire).
  notifyOnAssignment Boolean @default(true) @map("notify_on_assignment")
  /// Récapitulatif quotidien par courriel des tâches en cours/à venir.
  notifyDailyDigest  Boolean @default(true) @map("notify_daily_digest")
  /// Ordre personnalisé des entrées du menu de gauche (tableau JSON de
  /// `href`, ex. `["/taches","/projets",…]`) — null tant que l'utilisateur
  /// n'a rien réordonné, auquel cas l'ordre par défaut de NAV_ENTRIES
  /// s'applique. Une entrée absente de ce tableau (nouvel écran ajouté
  /// depuis) retombe en fin de liste dans son ordre par défaut.
  navOrder String? @map("nav_order")

  @@map("users")
}

// --------------------------------------------------------------------------
// Studios, personnes, équipe
// --------------------------------------------------------------------------

/// Les cinq studios de Média Animation, plus ceux qu'un administrateur
/// ajouterait depuis les Réglages. Deux couleurs par studio, reçues du
/// système de jetons réel (Claude Design, à partir de media-animation.be) :
/// `colorHex` est le ton saturé (texte sur aplat clair, petits indicateurs
/// pleins) et `fillHex` l'aplat clair associé (fond des badges/puces) —
/// chaque paire est vérifiée AA 4.5:1 minimum. `initial` reste utile dans
/// les contextes exigus (barres du Gantt) où le nom complet ne tient pas ;
/// partout ailleurs le nom complet du studio sert de second canal visuel.
model Studio {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  colorHex  String   @map("color_hex")
  fillHex   String   @map("fill_hex")
  initial   String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks    Task[]
  projects ProjectStudio[]
  people   PersonStudio[]
  requests Request[]

  @@map("studios")
}

/// Une personne de l'équipe : membre d'un studio, personne hors studio
/// (services internes), ou invité extérieur (freelance, partenaire). Le
/// compte de connexion (User) est optionnel : une personne peut exister sans
/// jamais se connecter (ex. ressource externe qu'on planifie sans lui donner
/// d'accès).
model Person {
  id        String   @id @default(cuid())
  name      String
  team      String? // "équipe ou service" en texte libre, comme le prototype
  external  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User?
  studios         PersonStudio[]
  tasks           Task[]
  subtasks        Subtask[]
  absences        Absence[]
  comments        Comment[]
  uploadedFiles   Attachment[]
  journalEntries  JournalEntry[]
  notifications   Notification[]
  mentions        CommentMention[]

  @@map("people")
}

/// Rattachement d'une personne à un ou plusieurs studios (facultatif).
model PersonStudio {
  personId String @map("person_id")
  studioId String @map("studio_id")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([personId, studioId])
  @@map("person_studios")
}

// --------------------------------------------------------------------------
// Projets et tâches
// --------------------------------------------------------------------------

enum ClientType {
  INTERNAL
  EXTERNAL
}

/// Client au sens organisation (ONG, fédération, service interne…), distinct
/// du type interne/externe porté par le projet. Une même organisation peut
/// revenir sur plusieurs projets ; centraliser son nom évite les doublons de
/// saisie ("Oxfam", "Oxfam Belgique", "OXFAM"…) et permet de gérer la liste
/// des clients depuis Réglages plutôt qu'en texte libre à chaque création.
model Client {
  id           String   @id @default(cuid())
  name         String   @unique
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  website      String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("clients")
}

/// Un projet peut concerner plusieurs studios à la fois (ex. une campagne
/// Graphisme + Web) : voir ProjectStudio.
model Project {
  id        String     @id @default(cuid())
  name      String
  client    Client     @relation(fields: [clientId], references: [id])
  clientId  String     @map("client_id")
  type      ClientType
  archived  Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  studios    ProjectStudio[]
  tasks      Task[]
  milestones Milestone[]

  @@map("projects")
}

model ProjectStudio {
  projectId String @map("project_id")
  studioId  String @map("studio_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([projectId, studioId])
  @@map("project_studios")
}

/// Étape clé d'un projet ("BAT validé", "livraison finale"…), datée mais sans
/// tâche ni personne assignée — sert de repère dans la vue Portefeuille et
/// sur la fiche projet, distinct des tâches qui portent le travail réel.
model Milestone {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  title     String
  dueDate   DateTime @map("due_date") @db.Date
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("milestones")
}

/// Statuts de tâche personnalisables (Réglages → Statuts), sur le même
/// principe que Studio : un administrateur les crée, les renomme et les
/// réordonne (`position`) plutôt que de choisir dans une liste figée.
/// `isDone` porte la seule sémantique qui compte pour le reste de
/// l'application (avancement à 100 %, sortie du calcul de charge) — les
/// anciens tests figés sur "DELIVERED" n'existent plus, seul ce booléen
/// distingue "terminé" de "pas terminé".
model TaskStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  colorHex  String   @map("color_hex")
  fillHex   String   @map("fill_hex")
  position  Int      @default(0)
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks Task[]

  @@map("task_statuses")
}

/// Fréquence d'une tâche récurrente — volontairement limité à deux options
/// simples (pas de RRULE complet à la Outlook) : couvre les cas réels d'une
/// petite équipe (réunion hebdomadaire, rapport mensuel) sans la complexité
/// d'un moteur de règles générique.
enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

/// Une tâche appartient à un seul studio (contrairement au projet). La
/// corbeille du prototype (`corbeille`/`jete`) devient `trashedAt` : une
/// tâche à la corbeille garde son historique, elle est filtrée par requête
/// plutôt que supprimée, jusqu'à destruction définitive par un administrateur
/// (Réglages → Corbeille).
///
/// `version` sert au verrouillage optimiste : chaque écriture transactionnelle
/// vérifie que `version` n'a pas changé depuis la lecture, puis l'incrémente
/// — reprend l'idée du compteur `rev` global du prototype (ligne 254 du
/// fichier source), appliquée par ligne plutôt que sur tout le jeu de
/// données.
model Task {
  id                String     @id @default(cuid())
  title             String
  description       String?
  project           Project?   @relation(fields: [projectId], references: [id])
  projectId         String?    @map("project_id")
  studio            Studio     @relation(fields: [studioId], references: [id])
  studioId          String     @map("studio_id")
  assignee          Person?    @relation(fields: [assigneeId], references: [id])
  assigneeId        String?    @map("assignee_id")
  startDate         DateTime   @map("start_date") @db.Date
  endDate           DateTime   @map("end_date") @db.Date
  /// Durée maximale en jours calendaires (Fin - Début + 1). Facultatif : un
  /// garde-fou contre une plage saisie par erreur, pas une estimation de
  /// charge (voir le module `src/lib/planning` pour l'avancement/la charge,
  /// qui restent distincts de cette borne).
  maxDurationDays   Int?       @map("max_duration_days")
  /// Estimation d'effort en demi-journées (1 = une demi-journée), distincte
  /// de la plage de dates : une tâche peut s'étaler sur cinq jours
  /// calendaires sans en occuper la personne à plein temps. Absente = ancien
  /// comportement dans le calcul de charge (tout jour couvert compte comme
  /// entièrement occupé) — voir src/lib/planning/availability.ts.
  estimatedHalfDays Int?       @map("estimated_half_days")
  status            TaskStatus @relation(fields: [statusId], references: [id])
  statusId          String     @map("status_id")
  dependsOn         Task?      @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependsOnId       String?    @map("depends_on_id")
  dependents        Task[]     @relation("TaskDependency")
  /// Récurrence facultative : quand la tâche passe à un statut "Terminé"
  /// (isDone), l'occurrence suivante est générée automatiquement (dates
  /// décalées de `recurrenceInterval` semaines/mois) — voir
  /// maybeGenerateNextOccurrence dans src/lib/actions/tasks.ts.
  /// `recurrenceParentId` détache l'occurrence de la tâche qui l'a générée
  /// (elle-même récurrente ou non) : sert uniquement de garde-fou pour ne
  /// générer la suite qu'une seule fois par tâche.
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  recurrenceInterval  Int?                 @map("recurrence_interval")
  recurrenceUntil     DateTime?            @map("recurrence_until") @db.Date
  recurrenceParent    Task?                @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceParentId  String?              @map("recurrence_parent_id")
  recurrenceChildren  Task[]               @relation("TaskRecurrence")
  validationRounds  Int        @default(0) @map("validation_rounds")
  version           Int        @default(0)
  trashedAt         DateTime?  @map("trashed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  subtasks       Subtask[]
  comments       Comment[]
  attachments    Attachment[]
  journalEntries JournalEntry[]

  @@index([studioId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([statusId])
  @@index([startDate, endDate])
  @@index([recurrenceParentId])
  @@map("tasks")
}

/// Sous-tâche avec échéance propre, éventuellement attribuée à quelqu'un
/// d'autre que le titulaire de la tâche (repris tel quel du prototype).
model Subtask {
  id       String    @id @default(cuid())
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String    @map("task_id")
  title    String
  dueDate  DateTime? @map("due_date") @db.Date
  assignee Person?   @relation(fields: [assigneeId], references: [id])
  assigneeId String? @map("assignee_id")
  done     Boolean   @default(false)
  position Int       @default(0)

  @@index([taskId])
  @@map("subtasks")
}

// --------------------------------------------------------------------------
// Absences, demandes, commentaires, pièces jointes, journal
// --------------------------------------------------------------------------

model Absence {
  id        String   @id @default(cuid())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String   @map("person_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([personId])
  @@map("absences")
}

/// File d'attente des demandes non planifiées ("ce qu'on vous demande dans
/// un couloir"). Convertie en Task par un responsable, puis supprimée —
/// même comportement que le prototype (la demande ne laisse pas de trace une
/// fois planifiée ; le journal, lui, garde l'écriture de création de tâche).
model Request {
  id           String   @id @default(cuid())
  subject      String
  requester    String?
  studio       Studio   @relation(fields: [studioId], references: [id])
  studioId     String   @map("studio_id")
  wantedFor    DateTime? @map("wanted_for") @db.Date
  detail       String?
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String? // nom affiché au dépôt, pas de FK : peut être "Anonyme"

  @@map("requests")
}

model Comment {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String   @map("task_id")
  author    Person?  @relation(fields: [authorId], references: [id])
  authorId  String?  @map("author_id")
  authorName String  @map("author_name") // figé à la publication, même si la personne est retirée plus tard
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  mentions CommentMention[]

  @@index([taskId])
  @@map("comments")
}

/// Personnes taguées ("@Nom") dans un commentaire — détectées à la saisie en
/// comparant le texte aux personnes existantes (voir addComment), stockées à
/// part plutôt que reparsées à chaque affichage. Chaque mention déclenche une
/// Notification de type MENTION pour la personne taguée.
model CommentMention {
  id        String   @id @default(cuid())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String   @map("comment_id")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String   @map("person_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([commentId, personId])
  @@map("comment_mentions")
}

enum NotificationType {
  ASSIGNMENT
  MENTION
  REQUEST
}

/// Notifications dans l'application (cloche de la barre latérale) — distinctes
/// des courriels envoyés par src/lib/mail : mêmes déclencheurs (attribution,
/// mention, nouvelle demande), mais toujours créées, sans préférence
/// d'activation (contrairement aux courriels, volontairement plus rares).
/// Pas de temps réel (WebSocket) par choix du brief : la cloche interroge par
/// sondage court côté client (voir notification-bell.tsx).
model Notification {
  id          String           @id @default(cuid())
  recipient   Person           @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String           @map("recipient_id")
  type        NotificationType
  message     String
  link        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, read])
  @@map("notifications")
}

enum AttachmentKind {
  LINK // adresse collée (SharePoint, Drive, autre)
  FILE // fichier déposé, stocké dans l'espace objet
}

model Attachment {
  id           String         @id @default(cuid())
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String         @map("task_id")
  name         String
  kind         AttachmentKind
  url          String? // lien externe si kind = LINK
  storageKey   String?        @map("storage_key") // clé objet si kind = FILE
  mimeType     String?        @map("mime_type")
  sizeBytes    Int?           @map("size_bytes")
  uploadedBy   Person?        @relation(fields: [uploadedById], references: [id])
  uploadedById String?        @map("uploaded_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([taskId])
  @@map("attachments")
}

/// Journal global des écritures (renommages, changements d'état,
/// suppressions...), lisible depuis Réglages → Journal. Le texte de
/// l'écriture (`action`) est une phrase française prête à afficher, comme
/// dans le prototype ("Tâche « X » créée") plutôt qu'une structure à
/// recomposer côté client.
model JournalEntry {
  id        String   @id @default(cuid())
  actor     Person?  @relation(fields: [actorId], references: [id])
  actorId   String?  @map("actor_id")
  actorName String   @map("actor_name")
  action    String
  /// Tâche concernée, quand l'écriture en vient — permet d'afficher
  /// l'historique d'une tâche précise plutôt que de ne lire que le journal
  /// global (Réglages → Journal). `SetNull` plutôt que `Cascade` : une tâche
  /// détruite définitivement ne doit pas effacer la trace de ce qui lui est
  /// arrivé avant sa suppression.
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId    String?  @map("task_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([taskId])
  @@map("journal_entries")
}
